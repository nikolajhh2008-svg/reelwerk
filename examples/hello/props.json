{
  "brand": { "bg": "#0B0B0D", "surface": "#18181B", "border": "#2A2A30", "text": "#F4F4F5", "dim": "#A1A1AA", "faint": "#71717A", "accent": "#4F7DF3", "accentSoft": "#7A9CF6", "fontDisplay": "\"Helvetica Neue\", Arial, sans-serif", "fontBody": "\"Helvetica Neue\", Arial, sans-serif" },
  "scenes": [
    { "for": 3, "layers": [
      { "component": "WordStagger", "props": { "text": "Everyone says you need more followers", "size": "heading", "fontWeight": 800, "justify": "center", "placement": "upper-third" } },
      { "component": "IconPop", "at": 1.6, "props": { "icon": "cross", "placement": "center" } }
    ]},
    { "for": 3, "transition": { "name": "push", "options": { "direction": "up" }, "for": 0.4 }, "layers": [
      { "component": "Highlight", "props": { "text": "You need better hooks", "size": "heading", "placement": "upper-third" } },
      { "component": "IconPop", "at": 1.2, "props": { "icon": "check", "placement": "center" } }
    ]},
    { "for": 3, "transition": { "name": "morph", "for": 0.45 }, "layers": [
      { "component": "CountUp", "props": { "from": 0, "to": 70, "suffix": "%", "size": "hero", "placement": "center" } },
      { "component": "FadeIn", "at": 1, "props": { "text": "goal: still watching after 3 seconds", "size": "subheading", "placement": "lower-third" } }
    ]}
  ],
  "composition": {
    "fps": 30, "width": 1080, "height": 1920,
    "tracks": [
      { "id": "atmo", "entries": [ { "at": 0, "for": 8.2, "component": "Vignette", "props": {} } ] },
      { "id": "sfx", "entries": [
        { "at": 1.6, "for": 0.4, "component": "AudioClip", "props": { "src": "sfx/ui/click2.ogg" } },
        { "at": 2.75, "for": 0.5, "component": "AudioClip", "props": { "src": "sfx/ui/rollover2.ogg" } },
        { "at": 3.8, "for": 0.4, "component": "AudioClip", "props": { "src": "sfx/interface/click_003.ogg" } },
        { "at": 5.6, "for": 0.5, "component": "AudioClip", "props": { "src": "sfx/impact/impactSoft_medium_001.ogg" } }
      ]}
    ]
  }
}
